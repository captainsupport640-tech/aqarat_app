import 'dart:io';
import 'package:flutter/material.dart';
import 'package:permission_handler/permission_handler.dart';
import '../app_data.dart';

class SecurityManager {
  /// طلب كافة الصلاحيات المطلوبة للمنظومة (للأندرويد والكمبيوتر)
  static Future<void> requestAllAppPermissions() async {
    if (Platform.isAndroid) {
      try {
        // 1. طلب صلاحيات التخزين والإشعارات الأساسية
        await [
          Permission.storage,
          Permission.notification,
        ].request();

        // 2. طلب صلاحية إدارة الملفات الكاملة للأندرويد الحديث (Android 11+)
        if (await Permission.manageExternalStorage.isDenied) {
          await Permission.manageExternalStorage.request();
        }

        // 3. طلب صلاحية الظهور فوق التطبيقات الأخرى (SYSTEM_ALERT_WINDOW)
        if (await Permission.systemAlertWindow.isDenied) {
          await Permission.systemAlertWindow.request();
        }
      } catch (e) {
        debugPrint('⚠️ خطأ أثناء طلب الصلاحيات على الأندرويد: $e');
      }
    } else if (Platform.isWindows) {
      debugPrint('🖥️ التطبيق يعمل على نظام ويندوز، الصلاحيات مفعلة تلقائياً.');
    }
  }

  /// التحقق من صلاحية الوصول للأقسام الحساسة بحسب دور المستخدم
  static bool canAccessSection(String sectionName) {
    String role = AppData.userRole; // 'مدير' | 'مدخل بيانات' | 'ضيف'

    if (role == 'مدير') {
      return true; // المدير يمتلك صلاحية كاملة
    }

    if (role == 'مدخل بيانات') {
      // حظر الأقسام الحساسة عن مدخل البيانات
      if (sectionName == 'الحسابات والخزينة' || 
          sectionName == 'التقرير العام' || 
          sectionName == 'الأرشيف') {
        return false;
      }
      return true;
    }

    // للضيف أو أي دور آخر
    return false;
  }

  /// عرض رسالة تنبيه عند محاولة دخول قسم غير مصرح به
  static void showAccessDeniedDialog(BuildContext context) {
    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        backgroundColor: const Color(0xFF2D2D2D),
        title: const Row(
          children: [
            Icon(Icons.lock, color: Colors.redAccent),
            SizedBox(width: 8),
            Text('صلاحيات غير كافية', style: TextStyle(color: Colors.white)),
          ],
        ),
        content: const Text(
          'عفواً، لا تملك الصلاحية الكافية لدخول هذا القسم. يرجى مراجعة مدير النظام.',
          style: TextStyle(color: Colors.white70),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: const Text('موافق', style: TextStyle(color: Colors.amber)),
          ),
        ],
      ),
    );
  }
}